# 生产/云主机环境变量模板
#   用法：cp .env.prod.example .env  然后把空值填上（.env 已在 .gitignore，不会进仓库）
#
# 注意：不要把填好的 .env 提交到仓库，也不要把密码贴进 issue / 聊天记录。

# ── 必填 ──────────────────────────────────────────────
# MySQL root 密码。compose 用它初始化容器，同时拼进 api 的 DATABASE_URL。
# 生成一个强密码：openssl rand -hex 24
#
# ⚠️ 不要用含 @ 的密码。密码是被直接拼进 DATABASE_URL 的：
#   mysql+pymysql://root:<密码>@mysql:3306/chatbot
# 而 URL 解析器在第一个 @ 处切断 userinfo，于是 "ab@cd" 会被解析成
# 密码 "ab" + 主机名 "cd@mysql"，容器里报「找不到主机」——很难联想到是密码的问题。
# hex 的字符集是 0-9a-f，不会撞上。（deploy.sh 会提前拦住含 @ 的密码。）
MYSQL_ROOT_PASSWORD=

# ── 端口 ──────────────────────────────────────────────
# 宿主机对外暴露的 API 端口。云主机安全组也要放行同一个端口。
API_PORT=8000

# ── Ollama ────────────────────────────────────────────
# 云主机上如果也跑了 Ollama，用 host.docker.internal（容器访问宿主机）；
# 如果 Ollama 在另一台机器上，填它的内网/公网地址，例如 http://10.0.0.8:11434
# 如果暂时不接 Ollama，保持原样即可：服务能启动，/health 里 ollama 会显示 false。
#
# 注意：Linux 上 host.docker.internal 不会自动解析（那是 Docker Desktop for Mac/Windows
# 才有的便利），compose 里已经给 api 加了 extra_hosts 映射，这里不用管。
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# 单次请求超时（秒）。给大模型生成留足时间，太小会在生成中途被掐断。
OLLAMA_TIMEOUT=120

# 需要给 Ollama 加一层反向代理 + 鉴权时，把 OLLAMA_BASE_URL 指向代理地址。

# ── 生成参数（可选）────────────────────────────────────
# ⚠️ 这三个变量必须在 compose 的 api.environment 里显式透传才有用：
# compose 的 .env 只负责「compose 文件内部的变量插值」，不会自动注入容器环境。
# 曾经就因为漏了透传，在这里改了 TEMPERATURE 而完全没生效。
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=2048
