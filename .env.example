# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 应用配置
APP_TITLE=Ollama 智能聊天助手
APP_THEME=light

# 生成参数
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=2048

# 后端 API 层（后端化新增）
# 数据库连接串（不写死密码，凭据通过环境变量注入）
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/chatbot?charset=utf8mb4
# Redis 连接串
REDIS_URL=redis://127.0.0.1:6379/0

# Docker Compose 用（容器内 MySQL root 密码）
MYSQL_ROOT_PASSWORD=change-me
